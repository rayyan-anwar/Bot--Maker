# Required
# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Provider API credentials: configure only providers you intend to enable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Runtime and development usage cap
NODE_ENV=development
PORT=3000
FREE_DAILY_MESSAGES=30
# Set to 1 only when deployed behind a trusted single reverse proxy.
TRUST_PROXY=0

# Optional PostgreSQL runtime. When set, the app reads/writes PostgreSQL; otherwise it uses JSON local storage. Run the JSON import before switching an existing dataset.
DATABASE_URL=
# Set PGSSL=disable only for a trusted local PostgreSQL instance.
PGSSL=
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# Optional semantic retrieval. Adds OpenAI embedding API cost when enabled.
BOTFORGE_EMBEDDINGS_ENABLED=false
BOTFORGE_EMBEDDING_MODEL=text-embedding-3-small
