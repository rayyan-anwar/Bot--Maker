# Required
# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Provider API credentials: configure only providers you intend to enable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Runtime and development usage cap
NODE_ENV=development
PORT=3000
FREE_DAILY_MESSAGES=30
# Set to 1 only when deployed behind a trusted single reverse proxy.
TRUST_PROXY=0

# Optional database migration utility (does not change application runtime)
DATABASE_URL=
# Set PGSSL=disable only for a trusted local PostgreSQL instance.
PGSSL=
PGSSL_REJECT_UNAUTHORIZED=true
