# Required
# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# Provider API credentials: configure only providers you intend to enable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Upload malware scanning. Production rejects uploads unless a ClamAV daemon is configured.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
MALWARE_SCAN_REQUIRED=true

# Runtime and development usage cap
NODE_ENV=development
PORT=3000
FREE_DAILY_MESSAGES=30
# Set to 1 only when deployed behind a trusted single reverse proxy.
TRUST_PROXY=0

# Optional PostgreSQL runtime. When set, the app reads/writes PostgreSQL; otherwise it uses JSON local storage. Run the JSON import before switching an existing dataset.
DATABASE_URL=
# Set PGSSL=disable only for a trusted local PostgreSQL instance.
PGSSL=
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# Optional semantic retrieval. Adds OpenAI embedding API cost when enabled.
BOTFORGE_EMBEDDINGS_ENABLED=false
BOTFORGE_EMBEDDING_MODEL=text-embedding-3-small

# Required: exactly one administrator identity. Set this to your own email before first launch.
BOTFORGE_ADMIN_EMAIL=admin@example.com
# One-time bootstrap only. Set in a secure server shell, run npm run admin:create, then unset immediately.
# BOTFORGE_ADMIN_PASSWORD=
# Optional display name for the initial administrator.
BOTFORGE_ADMIN_NAME=Administrator
# For password recovery only, set temporarily in a secure server shell; never commit a real value.
# BOTFORGE_ADMIN_NEW_PASSWORD=

# Optional JSON plan overrides, e.g. {"free":{"dailyMessages":30},"plus":{"dailyMessages":500},"pro":{"dailyMessages":2000}}
BOTFORGE_PLANS_JSON=

# Optional Stripe subscriptions. Never expose these values to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://your-domain.example/billing/success
STRIPE_CANCEL_URL=https://your-domain.example/billing/cancel

# Optional bearer token required to expose the Prometheus /metrics endpoint.
METRICS_TOKEN=

STRIPE_PORTAL_RETURN_URL=https://your-domain.example/billing.html

# Local PostgreSQL staging compose password. Use a URL-safe value.
POSTGRES_PASSWORD=

# Optional Razorpay subscriptions for India. Configure matching subscription plans in Razorpay Dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS=
RAZORPAY_PLAN_PRO=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# Optional Google OAuth. Register this exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/oauth/google/callback

# Optional GitHub OAuth App. Request read:user and user:email; register this exact callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/oauth/github/callback

# Optional AI Engineer read-only CI diagnosis. Use a fine-grained GitHub token with Actions: read only.
BOTFORGE_GITHUB_TOKEN=
# Separate fine-grained token used only after explicit admin confirmation to create branches, commits and draft PRs.
# Grant Contents: read/write and Pull requests: read/write only for the selected repository.
BOTFORGE_GITHUB_WRITE_TOKEN=
BOTFORGE_GITHUB_REPO=owner/repository
BOTFORGE_ENGINEER_PROVIDER=openai

# Optional password-reset email delivery through Resend. Without these, recovery requests stay generic and no email is sent.
RESEND_API_KEY=
BOTFORGE_EMAIL_FROM=BotForge <support@your-domain.example>
PUBLIC_BASE_URL=https://your-domain.example
