{
  "name": "botforge",
  "version": "1.0.0",
  "description": "BotForge: build, train and deploy AI assistants",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test",
    "migrate:postgres": "node scripts/migrate-json-to-postgres.js",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "restore:postgres": "bash scripts/restore-postgres.sh",
    "admin:reset-password": "node scripts/reset-admin-password.js",
    "admin:create": "node scripts/create-admin.js",
    "security:scan": "node scripts/security-scan.js",
    "staging:smoke": "node scripts/staging-smoke.js",
    "knowledge:evaluate": "node scripts/evaluate-knowledge-retrieval.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
